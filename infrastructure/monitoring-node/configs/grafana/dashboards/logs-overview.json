{
  "uid": "sentinelstack-logs-overview",
  "title": "SentinelStack - Logs Overview",
  "tags": ["sentinelstack", "devops", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "All SentinelStack Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"sentinelstack\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Backend Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"sentinelstack\", service=\"backend\"}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "NGINX Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"sentinelstack\", service=\"nginx\"}", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"sentinelstack\"} |~ \"(?i)error|exception|failed|fatal\"", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Log Rate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "logs/sec" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate({job=\"sentinelstack\"}[5m]))", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Logs by Service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "logs/sec" }, "overrides": [] },
      "targets": [{ "expr": "sum by (service) (rate({job=\"sentinelstack\"}[5m]))", "legendFormat": "{{ service }}", "refId": "A" }]
    }
  ]
}
