{
  "uid": "sentinelstack-logs-overview",
  "title": "SentinelStack - Logs Overview",
  "tags": ["sentinelstack", "devops", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "All App Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=~\".+\"}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Backend Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=~\".+\"} |= \"backend\"", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "NGINX Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=~\".+\"} |= \"nginx\"", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Error Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{job=~\".+\"} |~ \"(?i)error|exception|failed\"", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Log Rate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "logs/sec" }, "overrides": [] },
      "targets": [{ "expr": "sum(rate({job=~\".+\"}[5m]))", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "Logs by Job",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "logs/sec" }, "overrides": [] },
      "targets": [{ "expr": "sum by (job) (rate({job=~\".+\"}[5m]))", "legendFormat": "{{ job }}", "refId": "A" }]
    }
  ]
}
